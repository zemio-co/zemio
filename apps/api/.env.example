# Copy this file to .env and fill in the values below.

# Matches the local Postgres container started by `docker compose up -d`
DATABASE_URL="postgresql://postgres:postgres@localhost:5435/zemio"

# Port the API listens on. Must match the port in API_URL in apps/web/.env.
PORT=3001

# Shared secret for service-to-service auth with apps/web (min 32 chars).
# Must match INTERNAL_API_SECRET in apps/web/.env.
INTERNAL_API_SECRET=

# Key for decrypting banking details in generated PDFs.
# Must match SECRET_ENCRYPTION_KEY in apps/web/.env.
SECRET_ENCRYPTION_KEY=

# =====================================================================
# Storage (S3-compatible) — the same bucket apps/web uploads to
# =====================================================================

STORAGE_HOST=
STORAGE_REGION=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_ACCESS_KEY=
STORAGE_SECURE=true
STORAGE_FORCE_PATH_STYLE=false
