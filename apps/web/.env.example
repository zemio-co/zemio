# Copy this file to .env and fill in the values below.
# apps/api and packages/db each read their own .env, with their own example.

# =====================================================================
# Database
# =====================================================================

# Matches the local Postgres container started by `docker compose up -d`
DATABASE_URL="postgresql://postgres:postgres@localhost:5435/zemio"

# =====================================================================
# Runtime
# =====================================================================

# Base URL of this app
BETTER_AUTH_URL="http://localhost:3000"

# URL of the internal Hono API server (apps/api)
API_URL="http://localhost:3001"

# Secret key for signing authentication tokens. Optional in development,
# required in production. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Shared secret for service-to-service auth between web and apps/api
# (min 32 chars). Generate with: openssl rand -base64 32
INTERNAL_API_SECRET=

# Secret key for encrypting banking details.
# Generate with: openssl rand -base64 32
SECRET_ENCRYPTION_KEY=

# =====================================================================
# Microsoft OAuth
# =====================================================================
# From Azure AD App Registration > Certificates & secrets

MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# =====================================================================
# Storage (S3-compatible)
# =====================================================================

STORAGE_HOST=
STORAGE_REGION=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_ACCESS_KEY=
STORAGE_SECURE=true
STORAGE_FORCE_PATH_STYLE=false

# =====================================================================
# Email (Scaleway Transactional Email)
# =====================================================================

# Scaleway IAM secret key, sent as X-Auth-Token
# From https://console.scaleway.com/iam/api-keys
SCALEWAY_TEM_SECRET_KEY=

# Scaleway project the verified sending domain belongs to
SCALEWAY_TEM_PROJECT_ID=

# Sender of every outgoing email, as `Name <address>`. Required, and specific to
# this deployment: the address has to sit on a domain verified in *your* Scaleway
# project, so there is no default that could work anywhere else.
# For example: EMAIL_FROM="zemio <noreply@mail.example.com>"
EMAIL_FROM=

# =====================================================================
# AppSignal (optional — error tracking & monitoring)
# =====================================================================

# Push API key (server) and front-end key (browser) are DIFFERENT credentials,
# both under App settings > Push & deploy in AppSignal. Leave unset to run
# without monitoring.
APPSIGNAL_PUSH_API_KEY=
APPSIGNAL_FRONTEND_KEY=

# Name + environment identify the app; changing either creates a NEW app on
# appsignal.com rather than renaming the existing one.
APPSIGNAL_APP_NAME=zemio-web
APPSIGNAL_APP_ENV=development

# Release identifier for deploy markers and sourcemap matching. Baked into the
# image by CI from the commit SHA — do not set it here or on the platform.
# Unset locally, which simply means no deploy markers in development.
APP_REVISION=


# =====================================================================
# Billing (optional)
# =====================================================================

# Leave unset to run Zemio without billing: no billing interface appears and
# every organization is entitled. Set to "true" or "1" only if you have a
# Stripe account — the two variables below then become required at startup.
BILLING_ENABLED=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# =====================================================================
# Local development tuning (optional)
# =====================================================================

# Caps Turbopack's memory use, in megabytes (positive integer). Leave unset
# unless the dev server outgrows a memory-constrained machine.
TURBOPACK_MEMORY_LIMIT_MB=
