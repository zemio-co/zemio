// Core expense-report domain: Report → Expense → Attachment

model Report {
  id          String       @id @default(cuid())
  // Human-readable report number, unique and sequential per organization.
  // Issued by incrementing Organization.reportCounter inside the creating
  // transaction — never by a global sequence.
  tag         Int
  title       String
  description String?
  status      ReportStatus @default(DRAFT)
  paidAt      DateTime?

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  costUnitId String
  costUnit   CostUnit @relation(fields: [costUnitId], references: [id], onDelete: Cascade)

  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId String

  // Live reference used while the report is editable; may become null when
  // the owner deletes the banking details. Submitting requires it to be set
  // and copies the values into bankingSnapshot, which finalized reports and
  // PDF exports read.
  bankingDetailsId String?
  bankingDetails   BankingDetails? @relation(fields: [bankingDetailsId], references: [id], onDelete: SetNull)

  bankingSnapshot ReportBankingSnapshot?

  // Set once the report has been written into a DATEV export. Null means it is
  // still available for the next one, which is what prevents a double export.
  // Cleared when an export is deleted so its reports become available again.
  datevExportId String?
  datevExport   DatevExport? @relation(fields: [datevExportId], references: [id], onDelete: SetNull)

  createdAt     DateTime @default(now())
  lastUpdatedAt DateTime @updatedAt

  expenses Expense[]

  @@unique([organizationId, tag])
  @@index([ownerId, organizationId])
  @@index([organizationId, status])
  @@index([costUnitId])
  @@index([bankingDetailsId])
  @@index([createdAt])
  @@index([lastUpdatedAt])
  @@index([paidAt])
  @@index([datevExportId])
  @@map("report")
}

enum ReportStatus {
  DRAFT
  PENDING_APPROVAL
  NEEDS_REVISION
  ACCEPTED
  REJECTED
  PAID
}

model Expense {
  id          String      @id @default(cuid())
  description String?
  amount      Decimal     @db.Decimal(12, 2)
  // A calendar day, not an instant: an expense happened on the 1st of March,
  // never at an o'clock. Stored as `date`, so the stored value names one day and
  // nothing else — with a timestamp it was local midnight, and the DATEV export
  // (getUTC*) and the PDF (local format) disagreed by a day wherever the server
  // ran east of UTC.
  //
  // Written through `apps/web/src/lib/calendar-date.ts`, whose UTC midnight is
  // what Prisma turns into the right day: the pg adapter formats a `date`
  // parameter from the Date's UTC components.
  //
  // Read back, Prisma hands out UTC midnight, so a reader must use getUTC* or
  // format in UTC. Formatting locally still shifts the day west of UTC — see
  // apps/api/src/services/pdf/generate.ts and the report/review expense lists.
  startDate   DateTime @db.Date
  endDate     DateTime @db.Date
  type        ExpenseType

  // Which input tax the receipt carries, for the DATEV export (DEV-21).
  // Required for new RECEIPT expenses and meaningless for TRAVEL and FOOD,
  // which are Pauschalen and carry no input tax at all. Null on every row
  // written before the column existed; the export treats those as NONE rather
  // than inventing a deduction nobody entered.
  inputTaxRate InputTaxRate?

  // Deprecated: replaced by the typed travelDetail/foodDetail relations.
  // Kept until the contract migration drops it (see docs/schema-audit.md).
  meta Json?

  travelDetail TravelExpenseDetail?
  foodDetail   FoodExpenseDetail?

  reportId    String
  report      Report       @relation(fields: [reportId], references: [id], onDelete: Cascade)
  attachments Attachment[]

  @@index([reportId])
  @@map("expense")
}

enum ExpenseType {
  RECEIPT
  TRAVEL
  FOOD
}

// Input tax shown on a receipt, mapped to a DATEV BU-Schlüssel on export.
// STANDARD and REDUCED are the two German rates; NONE covers both a zero-rated
// purchase and a receipt with no deductible input tax, because DATEV books them
// the same way — an empty BU-Schlüssel.
enum InputTaxRate {
  STANDARD
  REDUCED
  NONE
}

// Type-specific expense data, one row per TRAVEL expense
model TravelExpenseDetail {
  id        String  @id @default(cuid())
  expenseId String  @unique
  expense   Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)

  from     String
  to       String
  distance Decimal @db.Decimal(8, 2)

  @@map("travel_expense_detail")
}

// Type-specific expense data, one row per FOOD expense
model FoodExpenseDetail {
  id        String  @id @default(cuid())
  expenseId String  @unique
  expense   Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)

  days               Int
  breakfastDeduction Decimal @db.Decimal(12, 2)
  lunchDeduction     Decimal @db.Decimal(12, 2)
  dinnerDeduction    Decimal @db.Decimal(12, 2)

  @@map("food_expense_detail")
}

model Attachment {
  id           String   @id @default(cuid())
  key          String
  size         BigInt
  originalName String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  expenseId    String
  expense      Expense  @relation(fields: [expenseId], references: [id], onDelete: Cascade)

  @@index([key])
  @@index([expenseId])
  @@map("attachment")
}
