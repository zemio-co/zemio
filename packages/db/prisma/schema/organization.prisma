// Multi-tenancy models, managed by the better-auth organization plugin

model Organization {
  id        String   @id
  name      String
  slug      String   @unique
  logo      String?
  metadata  String?
  createdAt DateTime

  // Last Report.tag issued to this organization. Incremented atomically when
  // a report is created, which is what makes report numbers per-org.
  reportCounter Int @default(0)

  // The Stripe customer this organization pays as. Null until it first needs
  // one: an owner reaching checkout, or a self-created organization starting
  // its trial, which happens at creation (ADR-0009). An organization that
  // never does either — every organization on a deployment that does not bill
  // — never gets one. Unique so a Stripe customer can be traced back to
  // exactly one organization.
  stripeCustomerId String? @unique

  // Whether entitlement is enforced for this organization. Off by default, and
  // read underneath the deployment-wide flag: turning billing on globally
  // enforces nothing until an organization is opted in, which is what makes the
  // first real test of billing one customer rather than all of them (ADR-0001).
  billingEnforced Boolean @default(false)

  members      Member[]
  invitations  Invitation[]
  joiningRules JoiningRule[]

  // The people whose last active organization this was. Only here because a
  // relation needs both sides; nothing reads it.
  lastActiveFor User[] @relation("LastActiveOrganization")

  reports        Report[]
  costUnits      CostUnit[]
  costUnitGroups CostUnitGroup[]
  settings       Settings?
  auditEvents    AuditEvent[]
  subscription   Subscription?

  @@map("organization")
}

model Member {
  id             String   @id
  userId         String
  organizationId String
  role           String
  createdAt      DateTime

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // A user can only be a member of an organization once. The session-create
  // hook's check-then-insert is not transactional; this constraint is the
  // real guard against duplicates from concurrent logins.
  @@unique([userId, organizationId])
  @@index([organizationId])
  @@map("member")
}

model Invitation {
  id             String   @id
  email          String
  inviterId      String
  organizationId String
  role           String?
  status         String
  expiresAt      DateTime
  createdAt      DateTime

  inviter      User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([organizationId])
  @@map("invitation")
}
